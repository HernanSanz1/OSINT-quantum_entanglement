# OSINT App v2 — git ignore rules
# This file protects secrets and build artifacts from being committed to git.

# ── Databases (contain case data) ─────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
osint_app/data/*.db

# ── API key / config files ────────────────────────────────────────────────────
osint_app/data/osint_config.json
.env
.env.*
*.key
*.secret
*_keys.json

# ── Python build artifacts ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
.eggs/

# ── Virtual environments ──────────────────────────────────────────────────────
venv/
env/
.venv/
.env/

# ── Reports / generated files ─────────────────────────────────────────────────
osint_app/data/results_legacy/
osint_app/reports/output/
*.html_report

# ── OS files ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE files ─────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ── Test artifacts ────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Linters ──────────────────────────────────────────────────────────────────
.ruff_cache/

# ── Resultados de investigaciones: contienen datos personales de terceros (LOPDP/RGPD) ──
# Nunca se versionan. Se guardan en la base de datos del caso o fuera del repositorio.
osint_results/
/veronicaup*.txt
/prob.txt
/duck.*.txt
/logistica_ecuador.txt
/amass_passive.txt

# Noticias CTI, dossiers por cliente y boletines: datos de cada usuario. Se guardan en su carpeta de datos
# (%LOCALAPPDATA%\SENTINEL\cti, ver osint_app/utils/data_paths.py); estas rutas antiguas solo quedan como respaldo.
sentinel_unified/modules/cti/store/
sentinel_unified/modules/reports/cti-altel/
